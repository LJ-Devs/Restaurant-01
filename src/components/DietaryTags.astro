---
import type { DietaryTag, Locale } from '~/config/types';
import { useTranslations } from '~/i18n';
import Icon from './Icon.astro';

interface Props {
  tags?: DietaryTag[];
  lang: Locale;
  class?: string;
}

const { tags = [], lang, class: className } = Astro.props;
const t = useTranslations(lang);

// Fixed, high-contrast colours (independent of the brand colours).
const styles: Record<DietaryTag, { icon: 'leaf' | 'sprout' | 'no-wheat'; class: string }> = {
  vegetarian: { icon: 'leaf', class: 'bg-[#e6f2e8] text-[#1d5631]' },
  vegan: { icon: 'sprout', class: 'bg-[#dff0ea] text-[#0f5240]' },
  'gluten-free': { icon: 'no-wheat', class: 'bg-[#f6ecd6] text-[#664409]' },
};
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-1.5', className]}>
      {tags.map((tag) => (
        <li
          class:list={[
            'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[0.8125rem] leading-none font-bold print:border print:border-current print:bg-transparent print:px-1.5 print:py-0.5 print:text-[8pt]',
            styles[tag].class,
          ]}
        >
          <Icon name={styles[tag].icon} size={15} />
          {t.menu.tags[tag]}
        </li>
      ))}
    </ul>
  )
}
