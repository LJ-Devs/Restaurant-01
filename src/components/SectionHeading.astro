---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  /** Visually smaller title (for side-by-side sections). */
  compact?: boolean;
  class?: string;
}

const { id, eyebrow, title, compact = false, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-3', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class:list={[compact ? 'text-3xl sm:text-4xl' : 'section-title']}>{title}</h2>
  <slot />
</div>
