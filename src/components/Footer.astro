---
import { site } from '~/config';
import type { Locale } from '~/config/types';
import { fill, routes, useTranslations, type PageKey } from '~/i18n';
import { telHref } from '~/lib/links';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Locale;
  page: PageKey | null;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const home = routes.home[lang];
const { legal } = site;

const socials = [
  { icon: 'instagram', name: 'Instagram', url: site.social.instagram },
  { icon: 'facebook', name: 'Facebook', url: site.social.facebook },
  { icon: 'tripadvisor', name: 'Tripadvisor', url: site.social.tripadvisor },
] as const;
---

<footer class="site-footer on-dark no-print bg-dark text-white">
  <div class="azulejo-band bg-white/20!" aria-hidden="true"></div>

  <div class="container-site grid gap-10 py-12 sm:py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-display text-3xl font-semibold">{site.name}</p>
      <p class="mt-3 max-w-sm text-white/80">{site.tagline[lang]}</p>
      <p class="mt-5 leading-relaxed text-white/80">
        {site.address.street}<br />{site.address.postalCode} {site.address.city}
      </p>
      <p class="mt-3 flex flex-col gap-1">
        <a href={telHref(site.contact.phone)} class="font-semibold text-white underline-offset-4 hover:underline">
          {site.contact.phone}
        </a>
        <a href={`mailto:${site.contact.email}`} class="font-semibold text-white underline-offset-4 hover:underline">
          {site.contact.email}
        </a>
      </p>
    </div>

    <nav aria-label={t.footer.info} class="md:col-span-4">
      <ul class="flex flex-col gap-1">
        <li>
          <a href={`${home}#${t.sectionIds.hours}`} class="inline-flex min-h-11 items-center font-semibold text-white hover:underline">
            {t.nav.hours}
          </a>
        </li>
        <li>
          <a href={routes.menu[lang]} class="inline-flex min-h-11 items-center font-semibold text-white hover:underline">
            {t.nav.menu}
          </a>
        </li>
        <li>
          <a
            href={routes.privacy[lang]}
            aria-current={page === 'privacy' ? 'page' : undefined}
            class="inline-flex min-h-11 items-center font-semibold text-white hover:underline"
          >
            {t.footer.privacy}
          </a>
        </li>
        <li>
          <LanguageSwitcher lang={lang} page={page} class="-ml-3 text-white! hover:bg-white/10!" />
        </li>
      </ul>
    </nav>

    <div class="flex flex-col gap-5 md:col-span-3">
      <a
        href="https://www.livroreclamacoes.pt"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-3 self-start rounded-xl border border-white/40 px-4 py-3 text-white no-underline hover:bg-white/10"
      >
        <Icon name="book" />
        <span class="leading-tight">
          <span class="block font-bold">{t.footer.complaints}</span>
          <span class="block text-xs text-white/80">livroreclamacoes.pt</span>
        </span>
        <span class="sr-only">({t.footer.complaintsLong}) {t.a11y.newTab}</span>
      </a>
      {
        socials.some((s) => s.url) && (
          <ul class="flex gap-2" aria-label={t.contact.social}>
            {socials.map(
              (social) =>
                social.url && (
                  <li>
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noopener"
                      class="flex size-11 items-center justify-center rounded-full border border-white/40 text-white hover:bg-white/10"
                    >
                      <Icon name={social.icon} size={22} />
                      <span class="sr-only">
                        {social.name} {t.a11y.newTab}
                      </span>
                    </a>
                  </li>
                ),
            )}
          </ul>
        )
      }
    </div>
  </div>

  <div class="border-t border-white/15 pb-[calc(4.5rem_+_env(safe-area-inset-bottom))] md:pb-0">
    <div class="container-site flex flex-col gap-3 py-6 text-sm text-white/80">
      {
        legal.disputeResolution && (
          <p>
            {t.footer.disputeResolution}{' '}
            <a href={legal.disputeResolution.url} target="_blank" rel="noopener" class="font-semibold text-white underline">
              {legal.disputeResolution.name}
            </a>
          </p>
        )
      }
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <p>
          © {year} {legal.companyName} · {t.footer.nif} {legal.nif}. {t.footer.rights}
        </p>
        {site.isDemo && <p class="text-white/80">{fill(t.footer.demo, { name: site.name })}</p>}
      </div>
    </div>
  </div>
</footer>
