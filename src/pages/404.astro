---
// "Page not found", in both languages (Netlify and Cloudflare serve it automatically).
import { site } from '~/config';
import { routes, useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';

const pt = useTranslations('pt');
const en = useTranslations('en');
---

<BaseLayout lang="pt" page={null} title={`${pt.notFound.title} · ${site.name}`} description={pt.notFound.text} noindex>
  <section class="container-site flex flex-col items-start gap-10 py-20 sm:py-28">
    <p class="font-display text-7xl font-semibold text-primary sm:text-8xl" aria-hidden="true">404</p>
    <div class="grid w-full gap-10 md:grid-cols-2">
      <div>
        <h1 class="text-3xl sm:text-4xl">{pt.notFound.title}</h1>
        <p class="mt-3 text-lg text-muted">{pt.notFound.text}</p>
        <a href={routes.home.pt} class="btn btn-primary mt-6">{pt.cta.backHome}</a>
      </div>
      <div lang="en">
        <h2 class="text-3xl sm:text-4xl">{en.notFound.title}</h2>
        <p class="mt-3 text-lg text-muted">{en.notFound.text}</p>
        <a href={routes.home.en} class="btn btn-outline mt-6">{en.cta.backHome}</a>
      </div>
    </div>
  </section>
</BaseLayout>
