# Optional local settings. To use them, copy this file and name the copy ".env".
# (On Netlify / Cloudflare Pages, set these as environment variables instead.)

# Which client config to use: the "id" of a config in src/config/.
# Leave empty to use src/config/site.config.ts.
SITE_CONFIG=

# Optional: the public web address, if different from "url" in the config.
SITE_URL=
